RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN=sepolia            # any viem chain name or id: sepolia | anvil | baseSepolia | 11155111 ...
DEPLOYER_KEY=0x...
BUYER_KEY=0x...
SELLER_KEY=0x...
ARBITER_KEY=0x...
JUNK_SELLER_KEY=0x...
EVALBOUNTY_ADDRESS=0x...
ARBITRATOR_ADDRESS=0x...
DEPLOY_BLOCK=0
MODEL_PROVIDER=auto      # auto (route by model id) | mock (force keyless mock) | anthropic | openai
MODEL_CALL_BUDGET=3000   # max paid model calls per process
OPENAI_REASONING_EFFORT=low
SELLER_DOMAINS=benchmark-reasoning,exact-answer-reasoning
BUYER_DOMAIN=benchmark-reasoning
TASK_SOURCE=real         # real (BBH + GSM8K snapshots) | synthetic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# META_EVIDENCE_URI=https://.../meta-evidence.json   # ERC-1497 dispute policy document baked into new deployments
# Committee arbitrator (optional; `pnpm --filter agents deploy-contracts -- --committee --switch`)
COMMITTEE_ADDRESS=
JUROR_KEYS=                      # comma-separated juror private keys for `pnpm --filter agents jurors`
JUROR_RUNS_MULTIPLIER=2          # jurors rerun with this many times the buyer's runs
BUYER_ENFORCE_SECURITY=0         # 1 = refuse bounties whose reward+bond exceed committee.securedValue()
BUYER_REWARD_ETH=0.002           # demo reward per bounty
# COMMITTEE_MIN_STAKE / COMMITTEE_JUROR_FEE / COMMITTEE_PANEL / COMMITTEE_COMMIT_WINDOW / COMMITTEE_REVEAL_WINDOW / COMMITTEE_SLASH_BPS / COMMITTEE_LAMBDA
